# ─────────────────────────────────────────────────────────────
# The Harvest by CloudTech Analytics: frontend environment (Vite)
# Copy to .env.local and fill in. Only PUBLIC values belong here:
# everything in this file is compiled into the browser bundle.
# Never put the service-role key or database password here.
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# Local development: http://127.0.0.1:54321 (printed by `npx supabase start`)
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe in the browser; RLS enforces access.
VITE_SUPABASE_ANON_KEY=

# 'development' | 'staging' | 'production'. Shown in the app footer and used to
# label non-production environments so test data is never mistaken for real data.
VITE_APP_ENV=development

# Product name shown in the UI (kept configurable in case the name changes).
VITE_PRODUCT_NAME=The Harvest
